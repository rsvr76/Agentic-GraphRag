# ==========================================
# TigerGraph Savanna Credentials
# ==========================================
TIGERGRAPH_HOST=https://your-instance.i.tgcloud.io
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=your_password_here
TIGERGRAPH_GRAPH=OlympicsCorpus
TIGERGRAPH_SECRET=
TIGERGRAPH_TOKEN=

# ==========================================
# LLM Providers (Google GenAI & Grok API)
# ==========================================
# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Grok (xAI) API Key & Base URL
XAI_API_KEY=your_grok_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1

# ==========================================
# Default Model Selections
# ==========================================
PRIMARY_LLM_PROVIDER=gemini           # Options: 'gemini' or 'grok'
GEMINI_MODEL=gemini-2.5-flash
GROK_MODEL=grok-beta
EMBEDDING_MODEL=text-embedding-004

# ==========================================
# Benchmark & Agent Harness Config
# ==========================================
MAX_AGENT_STEPS=8
TOP_K_RETRIEVAL=5
