# TigerGraph Savanna Credentials

# 1. TIGERGRAPH_HOST: In tgcloud.io -> Clusters, copy your instance URL.
#    Example: https://olympics-cluster.i.tgcloud.io
TIGERGRAPH_HOST=https://your-instance.i.tgcloud.io

# 2. TIGERGRAPH_USERNAME: Default is usually "tigergraph"
TIGERGRAPH_USERNAME=tigergraph

# 3. TIGERGRAPH_PASSWORD: The database password you chose when creating the cluster
TIGERGRAPH_PASSWORD=your_password_here

# 4. TIGERGRAPH_GRAPH: The graph name we will create and load into
TIGERGRAPH_GRAPH=Olympics

# 5. TIGERGRAPH_SECRET & TOKEN: Leave empty, pyTigerGraph creates them automatically
TIGERGRAPH_SECRET=
TIGERGRAPH_TOKEN=


# LLM Providers (Groq primary, Gemini fallback)

# Groq API Key (get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Key (fallback if Groq hits rate limits)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Active primary provider ('groq' or 'gemini')
PRIMARY_LLM_PROVIDER=groq

# Local Offline Embeddings (FastEmbed - 0 tokens, 100% offline)

LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32


# Agent Harness Parameters

MAX_AGENT_STEPS=6
TOP_K_RETRIEVAL=10
