
CREATE GRAPH Olympics ()

USE GRAPH Olympics


CREATE VERTEX Document (
    PRIMARY_ID doc_id STRING,
    title STRING,
    raw_text STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Chunk (
    PRIMARY_ID chunk_id STRING,     // format: {doc_id}::c{index}
    doc_id STRING,
    text STRING,
    start_offset INT,
    end_offset INT
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Athlete (
    PRIMARY_ID athlete_id STRING,
    name STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Event (
    PRIMARY_ID event_id STRING,
    name STRING,
    sport STRING,
    discipline STRING,
    gender STRING,
    competitors INT,
    nations INT
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Competition (
    PRIMARY_ID competition_id STRING,   // e.g. "2012 Summer", "2010 Winter"
    name STRING,
    year INT,
    season STRING,
    host_city STRING,
    host_country STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Venue (
    PRIMARY_ID venue_id STRING,
    name STRING,
    city STRING,
    country STRING,
    year_built INT
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Medal (
    PRIMARY_ID medal_id STRING,         // e.g. "gold", "silver", "bronze"
    medal_type STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Nation (
    PRIMARY_ID nation_id STRING,        // e.g. "USA", "HUN", "NED", "GER"
    name STRING,
    noc_code STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Date (
    PRIMARY_ID date_id STRING,          // e.g. "2012-08-04"
    date_str STRING,
    year INT,
    month INT,
    day INT
) WITH STATS="OUTDEGREE_BY_EDGETYPE";


CREATE DIRECTED EDGE WON_MEDAL (FROM Athlete, TO Medal, event_id STRING, competition_id STRING, date_held STRING) WITH REVERSE_EDGE="MEDAL_WON_BY";
CREATE DIRECTED EDGE COMPETED_IN (FROM Athlete, TO Event) WITH REVERSE_EDGE="HAS_COMPETITOR";
CREATE DIRECTED EDGE HELD_AT (FROM Event, TO Venue) WITH REVERSE_EDGE="HOSTED_EVENT";
CREATE DIRECTED EDGE PART_OF (FROM Event, TO Competition) WITH REVERSE_EDGE="INCLUDES_EVENT";
CREATE DIRECTED EDGE REPRESENTS (FROM Athlete, TO Nation) WITH REVERSE_EDGE="HAS_ATHLETE";

CREATE DIRECTED EDGE HAS_CHUNK (FROM Document, TO Chunk, chunk_index INT) WITH REVERSE_EDGE="CHUNK_OF_DOC";

CREATE DIRECTED EDGE MENTIONS_ATHLETE (FROM Document, TO Athlete, mention_chunk_id STRING) WITH REVERSE_EDGE="MENTIONED_IN_DOC_ATHLETE";
CREATE DIRECTED EDGE MENTIONS_EVENT (FROM Document, TO Event, mention_chunk_id STRING) WITH REVERSE_EDGE="MENTIONED_IN_DOC_EVENT";
CREATE DIRECTED EDGE MENTIONS_COMPETITION (FROM Document, TO Competition, mention_chunk_id STRING) WITH REVERSE_EDGE="MENTIONED_IN_DOC_COMP";
CREATE DIRECTED EDGE MENTIONS_VENUE (FROM Document, TO Venue, mention_chunk_id STRING) WITH REVERSE_EDGE="MENTIONED_IN_DOC_VENUE";
CREATE DIRECTED EDGE MENTIONS_NATION (FROM Document, TO Nation, mention_chunk_id STRING) WITH REVERSE_EDGE="MENTIONED_IN_DOC_NATION";

CREATE DIRECTED EDGE PRECEDES (FROM Competition, TO Competition) WITH REVERSE_EDGE="SUCCEEDS";
